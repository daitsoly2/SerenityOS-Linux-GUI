# Upstream snapshots behind this fork. Verified 2026-11-09.
# GTK3 has had no new release tarball after 3.24.43, so we pin the tip of the
# still-maintained gtk-3-24 branch (3.24.53, 2026-10-29) instead.

GTK3_VERSION=3.24.53
GTK3_COMMIT=bac4a949b151
GTK3_URL=https://codeload.github.com/GNOME/gtk/tar.gz/bac4a949b151
GTK3_SHA256=ad1c9e895eb73477deafb82cce270ad0d9eac5b44e036f346f4a77c3a979872f
GTK3_ARCHIVE=gtk3-branch.tar.gz

GTK4_VERSION=4.24.1
GTK4_URL=https://download.gnome.org/sources/gtk/4.24/gtk-4.24.1.tar.xz
GTK4_SHA256=e98abe720e16129c8c0f50761dee0a2e9ae2478055e31018f6cf977fcf6513e9
GTK4_ARCHIVE=gtk-4.24.1.tar.xz

LIBADWAITA_VERSION=1.10.0
LIBADWAITA_URL=https://download.gnome.org/sources/libadwaita/1.10/libadwaita-1.10.0.tar.xz
LIBADWAITA_SHA256=b1bf56239269d101a6391ad4553c910eff9cc6170b803916405477ef60a66c84
LIBADWAITA_ARCHIVE=libadwaita-1.10.0.tar.xz

# Where the patched libraries are installed on the target system.
SERENITY_GTK_PREFIX=/serenity/gtk
